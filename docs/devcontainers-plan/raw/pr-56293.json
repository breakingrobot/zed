    "organizations_url": "https://api.github.com/users/YauhenVasileusky/orgs",
    "repos_url": "https://api.github.com/users/YauhenVasileusky/repos",
    "events_url": "https://api.github.com/users/YauhenVasileusky/events{/privacy}",
    "received_events_url": "https://api.github.com/users/YauhenVasileusky/received_events",
